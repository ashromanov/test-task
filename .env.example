API_KEY=local-development-key
POSTGRES_PASSWORD=local-postgres-password
RABBITMQ_PASSWORD=local-rabbitmq-password
API_PORT=8000
DEMO_MODE=false
CONSUMER_PREFETCH=16
DB_POOL_SIZE=5
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=0.25
WEBHOOK_TIMEOUT=5
# Only for a trusted local receiver, e.g. receiver:8080. Empty in public demo.
WEBHOOK_ALLOWED_HOSTS=
